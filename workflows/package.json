{
  "name": "memoamo-workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node build.mjs",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit -p .",
    "eval": "tsx src/code-review/evals/run.ts",
    "comments": "tsx --env-file-if-exists=.env src/code-review/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@renderinc/sdk": "^1.11.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "openai": "^7.65.0",
    "pg": "^8.23.1",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
