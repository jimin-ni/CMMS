# 복사해서 .env.local 로 저장 후 값을 채웁니다. 실제 값은 Git에 올리지 않습니다.
# DATABASE_URL: Render 대시보드의 Postgres > Connections > External Database URL
#   끝에 ?sslmode=verify-full 을 붙입니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/DBNAME?sslmode=verify-full
# BETTER_AUTH_SECRET: 긴 임의 문자열 (예: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
