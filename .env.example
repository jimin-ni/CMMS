# 복사해서 .env.local 로 저장 후 값을 채웁니다. 실제 값은 Git에 올리지 않습니다.
# DATABASE_URL: Render 대시보드의 Postgres > Connections > External Database URL
#   끝에 ?sslmode=verify-full 을 붙입니다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/DBNAME?sslmode=verify-full
# BETTER_AUTH_SECRET: 긴 임의 문자열 (예: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# TYPESAFE_API_KEY: 버블 AI 반응 미리보기(Jev) 키. 비워 두면 미리보기가 꺼집니다.
TYPESAFE_API_KEY=
# YOUTUBE_API_KEY: YouTube Data API v3 키. 힙 채널 가져오기(npm run heap:channels)에만 쓰며, 비워 두면 그 스크립트가 멈춥니다.
YOUTUBE_API_KEY=
# OPENAI_API_KEY: AI 스크리닝의 OpenAI Moderation 키(docs/planning/12-ai-screening.md 5-4). 비워 두면 OpenAI 단계만 건너뛰고 사전·regex로만 판정합니다.
OPENAI_API_KEY=
# MODERATION_EMAIL_HMAC_KEY: 탈퇴 후 재가입 확인용 이메일 HMAC 키(같은 문서 16장). 팀 전체가 같은 값을 쓰고, 한 번 정하면 바꾸지 않습니다.
MODERATION_EMAIL_HMAC_KEY=
